+func TestCorePrimaryPreferenceRestoredAfterLateLeg0Join(t *testing.T) {
+	cfg := testCoreConfig()
+	cfg.ThresholdBytesPS = 1 << 60 // keep scheduler inactive/preferred for the assertion
+	core, appConn := newCore(cfg)
