+	if err := core.addLeg(0, slow, nil); err != nil {
+		t.Fatal(err)
+	}
+	a1, b1 := net.Pipe()
+	defer b1.Close()
+	if err := core.addLeg(1, a1, nil); err != nil {
+		close(release)
+		t.Fatal(err)
+	}
+
+	if !core.sendAckFrame(7, false) {
+		close(release)
+		t.Fatal("ACK was not scheduled")
+	}
