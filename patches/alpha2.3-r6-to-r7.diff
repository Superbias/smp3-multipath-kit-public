+func TestCoreAckBroadcastDoesNotHOLAcrossLegs(t *testing.T) {
+	cfg := testCoreConfig()
+	cfg.ThresholdBytesPS = 1 << 60
+	core, appConn := newCore(cfg)
+	defer core.Close()
+	defer appConn.Close()
+
+	a0, b0 := net.Pipe()
