+type delayedReadCloseConn struct {
+	net.Conn
+	started sync.Once
+	ready   chan struct{}
+	release chan struct{}
+}
+
+func (c *delayedReadCloseConn) Read(p []byte) (int, error) {
+	c.started.Do(func() { close(c.ready) })
+	n, err := c.Conn.Read(p)
+	if err != nil {
+		<-c.release
+	}
+	return n, err
+}
