+package multipath
+
+import (
+	"context"
+	"net"
+	"testing"
+	"time"
+
+	M "github.com/sagernet/sing/common/metadata"
+)
+
+func TestInboundWaitForSessionAllowsSecondaryBeforePrimary(t *testing.T) {
+	inbound := &Inbound{sessions: make(map[[16]byte]*serverSession)}
+	var id [16]byte
+	id[0] = 0x42
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+
+	result := make(chan *serverSession, 1)
+	go func() {
+		result <- inbound.waitForSession(ctx, id, 500*time.Millisecond)
+	}()
+
+	time.Sleep(40 * time.Millisecond)
+	core, appConn := newCore(testCoreConfig())
+	defer core.Close()
+	defer appConn.Close()
+	session := &serverSession{
+		id:          id,
+		destination: M.ParseSocksaddr("example.com:443"),
+		core:        core,
+		appConn:     appConn,
+	}
+	inbound.access.Lock()
+	inbound.sessions[id] = session
+	inbound.access.Unlock()
+
+	select {
+	case got := <-result:
+		if got != session {
+			t.Fatalf("waitForSession returned wrong session: got=%p want=%p", got, session)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("secondary did not observe primary session publication")
+	}
+}
+
+func TestInboundWaitForSessionTimesOut(t *testing.T) {
+	inbound := &Inbound{sessions: make(map[[16]byte]*serverSession)}
+	var id [16]byte
+	started := time.Now()
+	if got := inbound.waitForSession(context.Background(), id, 60*time.Millisecond); got != nil {
+		t.Fatal("unexpected session")
+	}
+	if elapsed := time.Since(started); elapsed < 40*time.Millisecond {
+		t.Fatalf("wait returned too early: %v", elapsed)
+	}
+}
+
+func TestServerSessionSerializesDuplicateLegJoin(t *testing.T) {
+	core, appConn := newCore(testCoreConfig())
+	defer core.Close()
+	defer appConn.Close()
+
+	a0, b0 := net.Pipe()
+	defer b0.Close()
+	if err := core.addLeg(0, a0, nil); err != nil {
+		t.Fatal(err)
+	}
+
+	a1, b1 := net.Pipe()
+	defer b1.Close()
+	if err := core.addLeg(1, a1, nil); err != nil {
+		t.Fatal(err)
+	}
+
+	session := &serverSession{core: core}
+	replacement, peer := net.Pipe()
+	defer peer.Close()
+	defer replacement.Close()
+	if err := session.attachLeg(1, replacement, nil); err == nil || err.Error() != "duplicate multipath leg" {
+		t.Fatalf("expected duplicate leg rejection, got %v", err)
+	}
+	if !core.hasLeg(0) || !core.hasLeg(1) {
+		t.Fatal("duplicate join disturbed existing logical session")
+	}
+}
