+#!/usr/bin/env bash
+set -euo pipefail
+ROOT="$(cd "$(dirname "$0")" && pwd)"
+NAME="smp3-multipath-kit-alpha2.3"
+STAGE_ROOT="${STAGE_ROOT:-$ROOT/.release-stage}"
+STAGE="$STAGE_ROOT/$NAME"
+OUT_ZIP="${1:-$ROOT/$NAME.zip}"
+
+LINUX_BIN="$ROOT/dist/smp3-proxy-linux-amd64"
+WINDOWS_BIN="$ROOT/dist/smp3-proxy-windows-amd64.exe"
+[ -x "$LINUX_BIN" ] || { echo "missing/non-executable final Linux binary; run ./build.sh first" >&2; exit 1; }
+[ -f "$WINDOWS_BIN" ] || { echo "missing final Windows binary; run ./build.sh first" >&2; exit 1; }
+
+rm -rf "$STAGE"
+mkdir -p "$STAGE" "$STAGE/dist" "$STAGE/config" "$STAGE/patches" "$STAGE/scripts" "$STAGE/src"
+
+for f in README.md README-zh_CN.md CHANGELOG.md BUILD_STATUS.md NOTICE.md VERSION \
+         build.sh validate-kit.sh install-server.sh install-client.ps1 package-release.sh \
+         UPGRADE-alpha2-to-alpha2.1.md UPGRADE-alpha2.1-to-alpha2.2.md; do
+  [ -f "$ROOT/$f" ] && cp -a "$ROOT/$f" "$STAGE/$f"
+done
+cp -a "$ROOT/config/." "$STAGE/config/"
+cp -a "$ROOT/patches/alpha2.2-to-alpha2.3.diff" "$STAGE/patches/"
+cp -a "$ROOT/scripts/." "$STAGE/scripts/"
+cp -a "$ROOT/src/." "$STAGE/src/"
+cp -a "$LINUX_BIN" "$WINDOWS_BIN" "$STAGE/dist/"
+
+# Never ship local deployment configs, cache or generated bytecode.
+find "$STAGE" -type d \( -name .git -o -name .work -o -name __pycache__ \) -prune -exec rm -rf {} +
+find "$STAGE" -type f \( -name '*.pyc' -o -name '*.pyo' -o -name 'dist.zip' -o -name 'config.json' -o -name 'client.json' -o -name 'server.json' \) -delete
+
+chmod 0755 "$STAGE/build.sh" "$STAGE/validate-kit.sh" "$STAGE/install-server.sh" "$STAGE/package-release.sh" "$STAGE/dist/smp3-proxy-linux-amd64"
+find "$STAGE/scripts" -maxdepth 1 -type f -name '*.sh' -exec chmod 0755 {} +
+find "$STAGE" -type f -name '*.json' -exec chmod 0644 {} +
+
+# Validate that example secret fields are placeholders rather than deployment credentials.
+python3 - "$STAGE/config" <<'PY'
+import json, pathlib, sys
+root = pathlib.Path(sys.argv[1])
+secret_keys = {'password', 'psk', 'obfs_password', 'key'}
+allowed_prefixes = ('YOUR_', 'CHANGE_')
+problems=[]
+def walk(v, path):
+    if isinstance(v, dict):
+        for k, x in v.items():
+            if k.lower() in secret_keys and isinstance(x, str) and x and not x.startswith(allowed_prefixes):
+                # Certificate/key filesystem paths are not secret values.
+                if k.lower() == 'key' and ('/' in x or '\\' in x):
+                    continue
+                problems.append(f'{path}: {k} is not a placeholder')
+            walk(x, path)
+    elif isinstance(v, list):
+        for x in v: walk(x, path)
+for p in root.glob('*.json'):
+    with p.open(encoding='utf-8') as f:
+        walk(json.load(f), p.name)
+if problems:
+    raise SystemExit('\n'.join(problems))
+PY
+
+# Binary checksums use portable relative names.
+(
+  cd "$STAGE/dist"
+  sha256sum smp3-proxy-linux-amd64 smp3-proxy-windows-amd64.exe > SHA256SUMS
+  sha256sum -c SHA256SUMS
+)
+
+# Source/release manifest excludes itself and binary checksums to avoid cycles.
+(
+  cd "$STAGE"
+  find . -type f \
+    ! -path './MANIFEST.sha256' \
+    ! -path './dist/SHA256SUMS' \
+    ! -path './dist/smp3-proxy-linux-amd64' \
+    ! -path './dist/smp3-proxy-windows-amd64.exe' \
+    -print0 | sort -z | xargs -0 sha256sum > MANIFEST.sha256
+  sha256sum -c MANIFEST.sha256
+)
+
+# Explicit cleanliness assertions.
+if find "$STAGE" -name .git -o -name .work -o -name __pycache__ | grep -q .; then
+  echo 'release staging contains forbidden metadata/cache' >&2
+  exit 1
+fi
+
+rm -f "$OUT_ZIP"
+(
+  cd "$STAGE_ROOT"
+  zip -q -r "$OUT_ZIP" "$NAME"
+)
+sha256sum "$OUT_ZIP" > "$OUT_ZIP.sha256"
+echo "[+] release: $OUT_ZIP"
+echo "[+] sha256: $OUT_ZIP.sha256"
