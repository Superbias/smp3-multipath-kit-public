+		settings.Cooldown = value
+	}
+	if value := time.Duration(options.MaxCooldown); value > 0 {
+		settings.MaxCooldown = value
+	}
+	if value := time.Duration(options.RecoveryStableWindow); value > 0 {
+		settings.RecoveryStableWindow = value
+	}
