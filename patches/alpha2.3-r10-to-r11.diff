+	if core.hasLeg(0) {
+		t.Fatal("old leg did not retire")
+	}
+	newA, newB := net.Pipe()
+	defer newB.Close()
+	if err := core.addLeg(0, newA, nil); err != nil {
+		t.Fatalf("same-id rejoin failed: %v", err)
