{
  "log": { "level": "info", "timestamp": true },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mihomo-local",
      "listen": "127.0.0.1",
      "listen_port": 2080
    }
  ],
  "outbounds": [
    {
      "type": "snell",
      "tag": "line-path",
      "server": "YOUR_LINE_ENTRY",
      "server_port": 12345,
      "version": 4,
      "psk": "YOUR_LINE_SNELL_PSK"
    },
    {
      "type": "hysteria2",
      "tag": "public-hy2",
      "server": "YOUR_LANDING_PUBLIC_IP",
      "server_port": 23457,
      "password": "YOUR_PUBLIC_HY2_PASSWORD",
      "tls": {
        "enabled": true,
        "server_name": "YOUR_HY2_SERVER_NAME",
        "insecure": false
      }
    },
    {
      "type": "snell",
      "tag": "public-snell",
      "server": "YOUR_LANDING_PUBLIC_IP",
      "server_port": 23456,
      "version": 4,
      "psk": "YOUR_PUBLIC_SNELL_PSK"
    },
    {
      "type": "multipath",
      "tag": "mp-jp",
      "outbounds": ["line-path", "public-hy2"],
      "preferred": "line-path",
      "udp_outbound": "line-path",
      "leg1_fallback": "public-snell",
      "leg1_adaptive": {
        "enabled": true,
        "evaluation_interval": "1s",
        "warmup": "5s",
        "suspect_window": "8s",
        "hard_failure_threshold": 2,
        "hard_failure_window": "15s",
        "cooldown": "90s",
        "max_cooldown": "5m",
        "recovery_stable_window": "20s",
        "min_tx_outstanding_frames": 64,
        "tx_ack_stall": "2s",
        "min_rx_reorder_frames": 64,
        "rx_gap_stall": "1500ms",
        "goodput_degrade_ratio": 0.4,
        "min_canary_useful_bytes": 1048576,
        "min_canary_active_windows": 3,
        "initial_failure_threshold": 3,
        "initial_failure_window": "30s"
      },
      "endpoints": [
        { "server": "YOUR_LANDING_PRIVATE_AGGREGATION_IP", "server_port": 24444 },
        { "server": "YOUR_LANDING_PRIVATE_AGGREGATION_IP", "server_port": 24444 }
      ],
      "password": "YOUR_SMP3_PASSWORD",
      "activation_threshold_mbps": 100,
      "activation_window": "1s",
      "chunk_size": 65536,
      "queue_frames": 256,
      "bandwidth_mbps": [128, 500],
      "max_reorder_frames": 4096,
      "max_inflight_frames": 1024,
      "ack_interval": "20ms",
      "retransmit_timeout": "1500ms",
      "recovery_timeout": "15s",
      "redial_interval": "1s"
    }
  ],
  "route": { "final": "mp-jp" }
}
