{
  "listen": "0.0.0.0:8443",
  "carrier_tls": {
    "cert_file": "/etc/smp3/tls/fullchain.pem",
    "key_file": "/etc/smp3/tls/privkey.pem"
  },
  "password": "REPLACE_WITH_LANDING_PASSWORD",
  "application_target": "127.0.0.1:9080",
  "max_sessions": 256,
  "max_connections": 512,
  "idle_timeout": "10m",
  "graceful_shutdown_timeout": "30s",
  "log_level": "info",
  "hello_read_timeout": "10s",
  "recovery_timeout": "15s",
  "stream": {
    "scheduler_mode": "aggregation",
    "capacity_mode": "dynamic",
    "activation_mode": "dynamic",
    "experimental_path_aware": false,
    "activation_threshold_mbps": 80,
    "activation_window": "1s",
    "chunk_size": 65536,
    "queue_frames": 256,
    "bandwidth_mbps": [
      100,
      95,
      90,
      85,
      80,
      75,
      70,
      65,
      60,
      55,
      50,
      45,
      40,
      35,
      30,
      25
    ],
    "max_active_legs": 16,
    "max_reorder_frames": 4096,
    "max_inflight_frames": 1024,
    "ack_interval": "20ms",
    "retransmit_timeout": "1500ms"
  },
  "udp": {
    "enabled": false,
    "mode": "adaptive",
    "queue_frames": 256,
    "max_datagram_size": 16384,
    "dedup_window": 4096,
    "idle_timeout": "2m",
    "adaptive_queue_delay": "120ms",
    "adaptive_duplicate_threshold": 0
  },
  "telemetry": {
    "enabled": true,
    "data_sequence_events": false,
    "listen": "127.0.0.1:24500",
    "snapshot_interval": "1s",
    "max_active_sessions": 1024,
    "max_events": 2048,
    "close_grace": "5s",
    "accounting_path": "/var/lib/smp3/traffic-accounting.json",
    "accounting_timezone": "UTC",
    "accounting_interval": "10s"
  }
}
