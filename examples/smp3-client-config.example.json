{
  "listen": "127.0.0.1:18080",
  "upstream_socks": {
    "address": "socks-gateway.example.invalid:7898",
    "connect_timeout": "10s"
  },
  "smp3": {
    "password": "CHANGE_ME",
    "carrier_ready_timeout": "5s",
    "routes": {
      "leg0": "smp3-leg0.example.invalid:24441",
      "leg1": "smp3-leg1.example.invalid:24442",
      "leg1_fallback": "smp3-leg1-fallback.example.invalid:24443"
    },
    "stream": {
      "scheduler_mode": "adaptive",
      "activation_threshold_mbps": 80,
      "activation_window": "1s",
      "chunk_size": 65536,
      "queue_frames": 256,
      "bandwidth_mbps": [128, 500],
      "max_reorder_frames": 4096,
      "max_inflight_frames": 1024,
      "ack_interval": "20ms",
      "retransmit_timeout": "1500ms",
      "recovery_timeout": "15s",
      "redial_interval": "1s"
    },
    "udp": {
      "enabled": true,
      "mode": "adaptive",
      "queue_frames": 256,
      "max_datagram_size": 16384,
      "dedup_window": 4096,
      "idle_timeout": "2m",
      "adaptive_queue_delay": "120ms",
      "adaptive_duplicate_threshold": 0
    }
  }
}
