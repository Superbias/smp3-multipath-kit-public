# Local Android/Go build outputs are never release source.
android/.gradle/
android/app/build/
android/build/
android/local.properties
.work/
dist/ARTIFACTS_SHA256
dist/release-*/
dist/*-dynamic
dist/*-dynamic.exe
# Local fault-test binaries and Mihomo cache; retain source/config/log evidence.
artifacts/slow-leg/native/
artifacts/slow-leg/smp3-server
artifacts/slow-leg/**/mihomo-home/

# Python audit helpers compile to disposable caches.
__pycache__/
